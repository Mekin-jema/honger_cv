# Copy this file to .env.local and fill in the values you use.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PERSONA_SIGNING_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter is preferred for CV PDF field mapping when configured.
OPENROUTER_API_KEY=
OPENROUTER_CV_MODEL=openrouter/free

# Gemini powers generated answers and is the fallback CV mapper.
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Cloudinary stores optimized customer profile photos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

MAIL_PROVIDER=none
RESEND_API_KEY=
MAIL_FROM=
ADMIN_OTP_STATIC=
NEXT_PUBLIC_BASE_PATH=
