# Copy this file to .env.local and fill in the values you use.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PERSONA_SIGNING_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Docling document parsing service (e.g. docling-serve container at http://localhost:5001).
# Converts PDF, DOCX, PPTX into structured Markdown while preserving layout, tables, and lists.
DOCLING_API_URL=
DOCLING_API_KEY=

# Optional separately hosted Resume Parser (PyMuPDF + validated parsing, OCR for scans).
# Also powers streaming, CV-grounded answers in the Ask AI live voice mode.
# Preferred for CV PDF import when both it and a URL are set. Leave blank to disable.
RESUME_PARSER_API_URL=
RESUME_PARSER_API_KEY=

# OpenRouter is used for CV PDF field mapping when no parser is configured.
OPENROUTER_API_KEY=
OPENROUTER_CV_MODEL=mistralai/mistral-small-24b-instruct-2501

# Gemini powers generated answers and is the fallback CV mapper.
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Payments (leave blank to disable provider checkout). Keep secret keys only in .env.local / deployment secrets.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Create an active USD 4.99 monthly subscription plan in PayPal and set its plan ID here.
PAYPAL_PORTFOLIO_PRO_PLAN_ID=
# Add the PayPal webhook URL /api/billing/paypal/webhook/ in the PayPal dashboard and set its webhook ID.
PAYPAL_WEBHOOK_ID=

# Cloudinary stores optimized customer profile photos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, set CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

MAIL_PROVIDER=none
RESEND_API_KEY=
MAIL_FROM=
ADMIN_OTP_STATIC=
NEXT_PUBLIC_BASE_PATH=
